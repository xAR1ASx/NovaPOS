rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function miNegocio() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.negocio_id;
    }

    function esDelNegocio(negocioId) {
      return autenticado() && miNegocio() == negocioId;
    }

    match /usuarios/{uid} {
      allow read: if autenticado() && (
        request.auth.uid == uid ||
        (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.negocio_id == resource.data.negocio_id &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'ADMIN')
      );

      allow create: if autenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'ADMIN' &&
        miNegocio() == request.resource.data.negocio_id;

      allow update: if autenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'ADMIN' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.negocio_id == resource.data.negocio_id &&
        request.resource.data.negocio_id == resource.data.negocio_id;

      allow delete: if false;
    }

    match /negocios/{negocioId} {
      allow read: if esDelNegocio(negocioId);
      
      // Prohibir que la app modifique campos críticos de licencia y el modo
      // del negocio (una caja / varias cajas): solo desde la consola.
      allow update: if esDelNegocio(negocioId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['financiado', 'estado', 'licencia_fin', 'modo_sync']));
        
      allow create: if false; // Solo se crean por backend/consola o functions

      // Datos de sincronización entre cajas (todo menos la copia en la nube).
      match /{coleccion}/{documento=**} {
        allow read, write: if esDelNegocio(negocioId) && coleccion != 'respaldos';
      }

      // Copia diaria en la nube: un índice que dice cuál es la copia vigente
      // y sus pedazos. Nadie puede borrar el índice ni los pedazos de la
      // copia vigente: el negocio nunca se queda sin copia.
      match /respaldos/indice {
        allow read: if esDelNegocio(negocioId);
        // Solo puede apuntar a una copia cuyo último pedazo ya está arriba.
        allow create, update: if esDelNegocio(negocioId) &&
          request.resource.data.partes is int &&
          request.resource.data.partes > 0 &&
          request.resource.data.partes <= 50 &&
          exists(/databases/$(database)/documents/negocios/$(negocioId)/respaldos/indice/partes/$(request.resource.data.copia_id + '_' + string(request.resource.data.partes - 1)));
        allow delete: if false;

        match /partes/{parteId} {
          allow read: if esDelNegocio(negocioId);
          // Se crean una vez y no se cambian.
          allow create: if esDelNegocio(negocioId) &&
            parteId == request.resource.data.copia_id + '_' + string(request.resource.data.parte);
          allow update: if false;
          allow delete: if esDelNegocio(negocioId) &&
            resource.data.copia_id != get(/databases/$(database)/documents/negocios/$(negocioId)/respaldos/indice).data.copia_id;
        }
      }
    }
  }
}